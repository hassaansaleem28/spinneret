# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must ship, or setup instructions cannot be followed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch. `data/*` rather than `data/` because git will not descend into
# an excluded directory, so a negation inside one never takes effect.
data/*
!data/snapshot.db
scraper-studio/logs/

# Presentation notes stay local. They are read aloud, not published.
DEMO.md
*.local.md
